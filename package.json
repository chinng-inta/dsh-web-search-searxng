{
  "name": "dsh-web-search-searxng",
  "version": "0.3.0",
  "description": "SearXNG-backed web search provider for the DeepSeek Harness web capability seam (ctx.web) — self-hosted metasearch, no API key, no model turn per search",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "searxng",
    "web-search",
    "metasearch",
    "self-hosted"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "author": "chinng_inta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinng-inta/dsh-web-search-searxng.git"
  },
  "bugs": {
    "url": "https://github.com/chinng-inta/dsh-web-search-searxng/issues"
  },
  "homepage": "https://github.com/chinng-inta/dsh-web-search-searxng#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web": "0.1.0-rc.6",
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
